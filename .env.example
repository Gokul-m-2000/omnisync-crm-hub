# Server
PORT=3001

# Where n8n listens. Local n8n default is port 5678.
# In n8n: open your workflow, click the Webhook node, and copy the URL.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/crm-sync

# Shared password used in BOTH directions:
#   server -> n8n   (header: X-Webhook-Secret)
#   n8n -> server   (header: X-Webhook-Secret)
# Change this before deploying anywhere public.
N8N_WEBHOOK_SECRET=dev-secret-change-me

# Which websites may call this API from a browser.
# Add your Vercel URL when deployed.
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# true  = clicking Sync fakes the result (clearly labelled "demo" in the UI)
# false = actually call n8n. Failures are shown as failures.
DEMO_MODE=false

# How long to wait for n8n before giving up
N8N_TIMEOUT_MS=15000
